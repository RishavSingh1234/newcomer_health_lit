---
import Layout from '../../layouts/Layout.astro';
import BloodPressureChecker from '../../components/BloodPressureChecker.astro';
---

<Layout
  title="Blood Pressure Checker | Newcomer Health Literacy Initiative"
  description="Enter an adult blood pressure reading to learn what the systolic and diastolic numbers may mean and when to seek medical advice."
>
  <main class="tool-page">
    <a class="back-link" href="/tools">← Back to tools</a>

    <BloodPressureChecker />
  </main>
</Layout>

<style>
  .tool-page {
    width: min(1000px, 90%);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: #14766f;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
