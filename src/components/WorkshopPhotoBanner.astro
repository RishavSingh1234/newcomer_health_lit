---
const photos = Object.entries(import.meta.glob('../assets/workshop-photos/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  query: '?url',
  import: 'default',
}))
  .map(([path, src]) => ({
    src: src as string,
    name: path.split('/').at(-1)?.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ') ?? 'Workshop moment',
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const { variant = 'wide' } = Astro.props;
---

{photos.length > 0 && (
  <section class:list={['photo-banner', variant]} aria-label="Photos from our community workshops">
    <div class="photo-frame">
      <div class="slides" aria-live="off">
        {photos.map((photo, index) => (
          <figure class:list={['slide', { active: index === 0 }]} aria-hidden={index !== 0}>
            <img src={photo.src} alt={`Community workshop photo ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} />
          </figure>
        ))}
      </div>
      <div class="banner-shade"></div>
      <div class="banner-controls" aria-label="Photo banner controls">
        <span class="slide-count" aria-live="polite"><span class="current">01</span> / {String(photos.length).padStart(2, '0')}</span>
        <button type="button" class="play-toggle" aria-label="Pause photo rotation" aria-pressed="false">Pause</button>
        <button type="button" class="previous" aria-label="Previous photo">←</button>
        <button type="button" class="next" aria-label="Next photo">→</button>
      </div>
    </div>
    <div class="banner-caption">
      <p class="eyebrow">Learning together</p>
      <h2>Health starts with community.</h2>
      <p>Moments from our health literacy workshops</p>
    </div>
    <span class="banner-progress" aria-hidden="true"><span></span></span>
  </section>
)}

{photos.length > 0 && <script>
  document.querySelectorAll('.photo-banner').forEach((banner) => {
    const slides = [...banner.querySelectorAll('.slide')];
    const currentLabel = banner.querySelector('.current');
    const pauseButton = banner.querySelector('.play-toggle');
    const progress = banner.querySelector('.banner-progress span');
    let index = 0;
    let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer;

    function show(nextIndex) {
      slides[index].classList.remove('active');
      slides[index].setAttribute('aria-hidden', 'true');
      index = (nextIndex + slides.length) % slides.length;
      slides[index].classList.add('active');
      slides[index].setAttribute('aria-hidden', 'false');
      currentLabel.textContent = String(index + 1).padStart(2, '0');
      progress.style.transform = `scaleX(${(index + 1) / slides.length})`;
    }

    function start() {
      clearInterval(timer);
      if (!paused && slides.length > 1) timer = setInterval(() => show(index + 1), 5000);
    }

    banner.querySelector('.previous').addEventListener('click', () => { show(index - 1); start(); });
    banner.querySelector('.next').addEventListener('click', () => { show(index + 1); start(); });
    pauseButton.addEventListener('click', () => {
      paused = !paused;
      pauseButton.textContent = paused ? 'Play' : 'Pause';
      pauseButton.setAttribute('aria-label', paused ? 'Start photo rotation' : 'Pause photo rotation');
      pauseButton.setAttribute('aria-pressed', String(paused));
      start();
    });
    banner.addEventListener('mouseenter', () => clearInterval(timer));
    banner.addEventListener('mouseleave', start);
    banner.addEventListener('focusin', () => clearInterval(timer));
    banner.addEventListener('focusout', start);
    start();
  });
</script>}

<style>
  .photo-banner { position: relative; width: 100%; overflow: hidden; border: 1px solid #d9e6e2; border-radius: 26px; background: #fff; color: #183a38; box-shadow: 0 22px 54px rgba(22, 75, 82, .1); }
  .photo-frame { position: relative; aspect-ratio: 1.4 / 1; overflow: hidden; background: #183a38; isolation: isolate; }
  .photo-banner.hero .photo-frame { aspect-ratio: 1.08 / 1; }
  .slides, .slide, .banner-shade { position: absolute; inset: 0; }
  .slide { margin: 0; opacity: 0; transition: opacity 900ms ease; }
  .slide.active { opacity: 1; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .banner-shade { z-index: 1; background: linear-gradient(0deg, rgba(12,35,33,.3), transparent 28%); }
  .banner-caption { padding: 20px 22px 22px; }
  .eyebrow { margin: 0 0 .35rem; color: #b64840; font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .banner-caption h2 { margin: 0 0 .25rem; color: #163b39; font-family: Georgia, serif; font-size: clamp(1.45rem, 2.5vw, 1.9rem); letter-spacing: -.03em; line-height: 1.15; }
  .banner-caption p:last-child { margin: 0; color: #617774; font-size: .92rem; }
  .banner-controls { position: absolute; z-index: 3; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 8px; }
  .slide-count { margin-right: 3px; color: white; font-size: .78rem; font-variant-numeric: tabular-nums; font-weight: 750; text-shadow: 0 1px 4px rgba(0,0,0,.8); }
  .banner-controls button { min-width: 42px; height: 42px; padding: 0 12px; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; background: rgba(15,40,37,.46); color: white; cursor: pointer; font-weight: 800; backdrop-filter: blur(8px); }
  .banner-controls button:hover { background: rgba(255,255,255,.22); }
  .banner-controls button:focus-visible { outline: 3px solid #ffc877; outline-offset: 3px; }
  .banner-progress { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; height: 4px; background: rgba(255,255,255,.25); }
  .banner-progress span { display: block; width: 100%; height: 100%; transform: scaleX(.05); transform-origin: left; background: #f07768; transition: transform 600ms ease; }
  @media (max-width: 600px) { .photo-frame { aspect-ratio: 1.15 / 1; } .photo-banner.hero .photo-frame { aspect-ratio: 1.25 / 1; } .banner-caption { padding: 17px 18px 19px; } .banner-controls { right: 12px; bottom: 12px; gap: 6px; } .banner-controls button { min-width: 36px; height: 36px; padding: 0 9px; } }
  @media (max-width: 850px) { .photo-banner.hero .photo-frame { aspect-ratio: 1.55 / 1; } }
  @media (prefers-reduced-motion: reduce) { .slide, .banner-progress span { transition: none; } }
</style>
