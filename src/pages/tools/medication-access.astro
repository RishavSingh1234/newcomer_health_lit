---
import Layout from '../../layouts/Layout.astro';
import MedicationAccessHelper from '../../components/MedicationAccessHelper.astro';
---

<Layout
  title="Medication Access Helper | Newcomer Health Literacy Initiative"
  description="Get practical guidance about prescription costs, refills, pharmacist services, Fair PharmaCare, and IFHP coverage in British Columbia."
>
  <main class="tool-page">
    <a class="back-link" href="/tools">← Back to tools</a>

    <MedicationAccessHelper />
  </main>
</Layout>

<style>
  .tool-page {
    width: min(1000px, 90%);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: #14766f;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
