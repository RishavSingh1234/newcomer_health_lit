                <div class="certificate-brand">
                  Newcomer Health Literacy Initiative
                </div>
              </div>

              <div class="certificate-decoration">
                <span></span>
                <strong>Certificate of Completion</strong>
                <span></span>
              </div>

              <p class="certificate-presents">
                This certificate is presented to
              </p>

              <div
                class="certificate-name"
                data-certificate-name
              >
                Learner Name
              </div>

              <p class="certificate-copy">
                for successfully completing the learning module
              </p>

              <h2>
                How Healthcare Works in B.C.
              </h2>

              <p class="certificate-description">
                A newcomer health literacy module covering health coverage,
                primary care, urgent and emergency services, referrals,
                medications, healthcare costs and language support in
                British Columbia.
              </p>

              <div class="certificate-footer">
                <div class="certificate-footer-item">
