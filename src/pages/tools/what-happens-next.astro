---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="What Happens Next? | Newcomer Health Literacy Initiative"
  description="An interactive B.C. healthcare navigation tool that explains what usually happens next after referrals, tests, prescriptions, and emergency visits."
>
  <main class="app-page">
    <div class="topbar">
      <a href="/tools" class="back-link">← Back to tools</a>
      <span class="mode"><i></i> B.C. Healthcare Navigation Mode</span>
    </div>

    <section class="navigator" data-app>
      <header class="hero">
        <div>
          <span class="badge">🧭 Interactive navigator</span>
          <h1>What Happens Next?</h1>
          <p>
            Choose what happened in your healthcare journey. We’ll show you where you are,
            what usually happens next, and what action may help.
          </p>
        </div>

        <div class="ready">
          <span>Status</span>
          <strong><i></i> Ready</strong>
        </div>
      </header>

      <div class="app-grid">
        <aside class="sidebar">
          <div class="sidebar-heading">
            <span>01</span>
            <div>
              <strong>What happened?</strong>
              <small>Choose your situation</small>
            </div>
          </div>

          <div class="scenario-list">
            <button class="scenario lab" type="button" data-scenario="lab">
              <span class="scenario-icon">🧪</span>
              <span class="scenario-copy">
                <em>Testing</em>
                <strong>Lab requisition</strong>
                <small>Bloodwork or another lab test</small>
              </span>
              <span class="dot"></span>
            </button>

            <button class="scenario imaging" type="button" data-scenario="imaging">
              <span class="scenario-icon">🩻</span>
              <span class="scenario-copy">
                <em>Diagnostic</em>
                <strong>Medical imaging</strong>
                <small>X-ray, ultrasound, CT or MRI</small>
              </span>
              <span class="dot"></span>
            </button>

            <button class="scenario referral" type="button" data-scenario="referral">
              <span class="scenario-icon">📨</span>
              <span class="scenario-copy">
                <em>Specialist care</em>
                <strong>Specialist referral</strong>
                <small>My provider sent a referral</small>
              </span>
              <span class="dot"></span>
            </button>

            <button class="scenario prescription" type="button" data-scenario="prescription">
              <span class="scenario-icon">💊</span>
              <span class="scenario-copy">
                <em>Medication</em>
                <strong>Prescription</strong>
                <small>I was prescribed a medication</small>
              </span>
              <span class="dot"></span>
            </button>

            <button class="scenario discharge" type="button" data-scenario="discharge">
              <span class="scenario-icon">🏥</span>
              <span class="scenario-copy">
                <em>Follow-up</em>
                <strong>ER discharge</strong>
                <small>I went home after an ER visit</small>
              </span>
              <span class="dot"></span>
            </button>

            <button class="scenario waiting" type="button" data-scenario="waiting">
              <span class="scenario-icon">⏳</span>
              <span class="scenario-copy">
                <em>Status check</em>
                <strong>I’m still waiting</strong>
                <small>I haven’t heard what happens next</small>
              </span>
              <span class="dot"></span>
            </button>
          </div>
        </aside>

        <section class="workspace">
          <div class="empty" data-empty>
            <div class="radar">
              <span></span>
              <span></span>
              <b>🧭</b>
            </div>

            <small>Navigator ready</small>
            <h2>What happened to you?</h2>
            <p>
              Choose a situation on the left. Your healthcare journey will appear here
              without opening another page.
            </p>
          </div>

          <div class="journey hidden" data-journey>
            <div class="journey-title">
              <div class="journey-icon" data-icon>📨</div>
              <div>
                <small>Your healthcare journey</small>
                <h2 data-title></h2>
                <p data-intro></p>
              </div>
            </div>

            <section class="panel">
              <div class="panel-heading">
                <div>
                  <small>Journey map</small>
                  <h3>Where am I in the process?</h3>
                </div>
                <span>Click any stage</span>
              </div>

              <div class="journey-track" data-track></div>
            </section>

            <section class="stage-detail">
              <div class="stage-number" data-stage-number>1</div>

              <div>
                <small data-stage-status>You are here</small>
                <h3 data-stage-title></h3>
                <p data-stage-description></p>

                <div class="tip">
                  <span>💡</span>
                  <span>
                    <strong>Helpful to know:</strong>
                    <span data-stage-tip></span>
                  </span>
                </div>
              </div>
            </section>

            <section class="next-card">
              <div class="next-heading">
                <span>🧭</span>
                <div>
                  <small>Your next move</small>
                  <h3>What should I do right now?</h3>
                </div>
              </div>

              <div class="next-main">
                <span data-next-icon>📞</span>
                <div>
                  <strong data-next-title></strong>
                  <p data-next-text></p>
                </div>
              </div>

              <div class="actions">
                <button class="primary" type="button" data-open-sos>
                  🆘 I’m still stuck
                </button>

                <button class="secondary" type="button" data-toggle-checklist>
                  ☑ Show my checklist
                </button>
              </div>
            </section>

            <section class="panel checklist hidden" data-checklist-box>
              <div class="panel-heading">
                <div>
                  <small>Quick checklist</small>
                  <h3>Things worth keeping track of</h3>
                </div>
                <button class="mini-close" type="button" data-close-checklist>×</button>
              </div>

              <div class="check-grid" data-checklist></div>
            </section>
          </div>
        </section>
      </div>

      <footer class="app-footer">
        <p>
          ⚠️ This tool explains healthcare navigation, not diagnosis or treatment.
          For a life-threatening emergency, call <strong>9-1-1</strong>.
        </p>

        <a
          href="https://www.healthlinkbc.ca/more/contact-us/8-1-1"
          target="_blank"
          rel="noopener noreferrer"
        >
          HealthLink BC 8-1-1 ↗
        </a>
      </footer>
    </section>

    <div class="modal-overlay" data-modal aria-hidden="true">
      <section class="sos-modal" role="dialog" aria-modal="true" aria-labelledby="sos-title">
        <div data-sos-menu>
          <div class="modal-header">
            <div>
              <small>Navigation SOS</small>
              <h2 id="sos-title">I’m stuck</h2>
            </div>
            <button type="button" data-close-sos aria-label="Close">×</button>
          </div>

          <p>Which problem is closest to yours?</p>

          <div class="sos-grid">
            <button type="button" data-issue="no-contact">
              <span>📵</span>
              <div>
                <strong>Nobody has contacted me</strong>
                <small>I expected a call or appointment</small>
              </div>
              <b>→</b>
            </button>

            <button type="button" data-issue="who">
              <span>📞</span>
              <div>
                <strong>I don’t know who to contact</strong>
                <small>I’m not sure which clinic is responsible</small>
              </div>
              <b>→</b>
            </button>

            <button type="button" data-issue="paperwork">
              <span>📄</span>
              <div>
                <strong>I don’t understand what I was given</strong>
                <small>A form, instruction, referral or prescription</small>
              </div>
              <b>→</b>
            </button>

            <button type="button" data-issue="next">
              <span>🧭</span>
              <div>
                <strong>I don’t know what to do next</strong>
                <small>Just tell me my next move</small>
              </div>
              <b>→</b>
            </button>
          </div>
        </div>

        <div class="sos-answer hidden" data-sos-answer>
          <div class="modal-header">
            <button class="back" type="button" data-sos-back>← Back</button>
            <button type="button" data-close-sos-answer aria-label="Close">×</button>
          </div>

          <div class="answer-icon">🧭</div>
          <small>Your next move</small>
          <h2 data-answer-title></h2>
          <div class="answer-steps" data-answer-steps></div>

          <div class="say-this">
            <small>You can say:</small>
            <p data-answer-script></p>
          </div>

          <button class="primary" type="button" data-got-it>✓ Got it</button>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  function initNavigator() {
    const app = document.querySelector('[data-app]');

    if (!app || app.dataset.ready === 'true') {
      return;
    }

    app.dataset.ready = 'true';

    const journeys = {
      lab: {
        icon: '🧪',
        title: 'Lab requisition',
        intro:
          'A healthcare provider ordered laboratory testing such as bloodwork or a urine test.',
        current: 1,
        stages: [
          [
            '🩺',
            'Test ordered',
            'Your healthcare provider decides laboratory testing may help with your care.',
            'Ask whether there are preparation instructions.'
          ],
          [
            '📄',
            'Requisition received',
            'You receive the order describing which tests were requested.',
            'Keep a paper requisition safe if one was given to you.'
          ],
          [
            '📍',
            'Find a lab',
            'You identify an appropriate laboratory service.',
            'Ask the ordering clinic if you do not know where to go.'
          ],
          [
            '🧪',
            'Test completed',
            'The requested sample is collected and tested.',
            'Follow any fasting, timing or preparation instructions.'
          ],
          [
            '📤',
            'Results sent',
            'Results are generally sent to the provider who ordered the test.',
            'The laboratory usually does not manage your medical follow-up.'
          ],
          [
            '🩺',
            'Provider reviews results',
            'The ordering provider reviews the results and decides whether follow-up is needed.',
            'Ask how the clinic normally communicates results.'
          ]
        ],
        next: [
          '📄',
          'Check your requisition and instructions',
          'Find out where the test can be completed and whether you need to prepare in any special way.'
        ],
        checklist: [
          ['📄', 'Requisition', 'Bring it if you were given a paper copy.'],
          ['🪪', 'Identification', 'Bring requested identification or health information.'],
          ['📋', 'Instructions', 'Review preparation instructions if provided.'],
          ['🩺', 'Ordering provider', 'Know which clinic ordered the test.']
        ]
      },

      imaging: {
        icon: '🩻',
        title: 'Medical imaging',
        intro:
          'Your healthcare provider ordered an imaging test such as an X-ray, ultrasound, CT or MRI.',
        current: 1,
        stages: [
          [
            '🩺',
            'Imaging ordered',
            'Your healthcare provider requests an imaging study.',
            'Ask which imaging test was ordered.'
          ],
          [
            '📨',
            'Request sent',
            'The request may be sent directly or given to you as a requisition.',
            'Different tests use different booking processes.'
          ],
          [
            '📅',
            'Appointment arranged',
            'You may book the test yourself or be contacted by an imaging facility.',
            'If nobody explained the booking process, ask the ordering clinic.'
          ],
          [
            '🩻',
            'Imaging completed',
            'The imaging study is performed.',
            'Follow any preparation instructions from the facility.'
          ],
          [
            '📝',
            'Report created',
            'The images are reviewed and a report is produced.',
            'The imaging facility may not be the place that explains the result.'
          ],
          [
            '🩺',
            'Provider reviews report',
            'The ordering provider receives the report.',
            'Ask how the ordering clinic communicates results.'
          ]
        ],
        next: [
          '📅',
          'Find out who arranges the appointment',
          'Ask whether you should book the imaging yourself or wait for the imaging facility to contact you.'
        ],
        checklist: [
          ['📄', 'Imaging order', 'Keep any requisition you were given.'],
          ['📞', 'Contact information', 'Make sure clinics can reach you.'],
          ['📋', 'Preparation', 'Follow preparation instructions carefully.'],
          ['🩺', 'Ordering provider', 'Know which clinic ordered the imaging.']
        ]
      },

      referral: {
        icon: '📨',
        title: 'Specialist referral',
        intro:
          'Your healthcare provider asked a specialist or specialty service to assess you.',
        current: 1,
        stages: [
          [
            '🩺',
            'Referral requested',
            'Your provider decides specialist input may be helpful and prepares a referral.',
            'Ask which specialist or clinic the referral is being sent to.'
          ],
          [
            '📨',
            'Referral sent',
            'The referring clinic sends your information to the specialist or specialty service.',
            'Make sure the referring clinic has your current phone number.'
          ],
          [
            '📥',
            'Referral received',
            'The specialist office receives and reviews the information.',
            'You may not receive an immediate confirmation when a referral arrives.'
          ],
          [
            '⚖️',
            'Referral reviewed',
            'The specialist or service reviews the referral and determines the next step.',
            'Wait times vary by specialty, availability and urgency.'
          ],
          [
            '📞',
            'Appointment arranged',
            'You or the referring clinic may receive scheduling information.',
            'Check voicemail and answer unfamiliar calls while waiting.'
          ],
          [
            '👨‍⚕️',
            'Specialist visit',
            'You attend the appointment and may receive testing, treatment or follow-up.',
            'Bring your medication list and questions.'
          ]
        ],
        next: [
          '📞',
          'Know where your referral was sent',
          'Ask the referring clinic for the specialist or clinic name and what they expect to happen next.'
        ],
        checklist: [
          ['📅', 'Referral date', 'Write down approximately when the referral was sent.'],
          ['🏥', 'Clinic name', 'Keep the specialist or clinic name if known.'],
          ['📞', 'Phone number', 'Make sure your contact information is current.'],
          ['📝', 'Questions', 'Write down questions for your specialist visit.']
        ]
      },

      prescription: {
        icon: '💊',
        title: 'Prescription',
        intro:
          'A healthcare provider prescribed a medication or treatment for you.',
        current: 1,
        stages: [
          [
            '🩺',
            'Medication prescribed',
            'Your healthcare provider decides to prescribe a medication.',
            'Ask why you are taking it.'
          ],
          [
            '📄',
            'Prescription provided',
            'The prescription may be given to you or sent to a pharmacy.',
            'Confirm which pharmacy received it.'
          ],
          [
            '💊',
            'Pharmacy prepares it',
            'A pharmacist reviews and prepares the medication.',
            'The pharmacy may contact the prescriber if clarification is needed.'
          ],
          [
            '🗣️',
            'Medication explained',
            'The pharmacist can explain how to take the medication.',
            'Ask questions if the instructions are unclear.'
          ],
          [
            '🔄',
            'Refills or follow-up',
            'Some prescriptions include refills while others require another assessment.',
            'Check how many refills remain before you run out.'
          ]
        ],
        next: [
          '💊',
          'Confirm which pharmacy has the prescription',
          'Then ask the pharmacist about instructions, cost, coverage and refills.'
        ],
        checklist: [
          ['🏪', 'Pharmacy', 'Know which pharmacy has your prescription.'],
          ['💳', 'Coverage', 'Bring drug insurance or PharmaCare information if relevant.'],
          ['📋', 'Medication list', 'Tell the pharmacist what else you take.'],
          ['🔄', 'Refills', 'Check whether refills are available.']
        ]
      },

      discharge: {
        icon: '🏥',
        title: 'Emergency Department discharge',
        intro:
          'You were assessed in the Emergency Department and were able to go home with instructions or follow-up recommendations.',
        current: 2,
        stages: [
          [
            '🏥',
            'Emergency assessment',
            'You were assessed and received appropriate emergency care.',
            'Emergency Departments prioritize patients according to medical urgency.'
          ],
          [
            '📄',
            'Discharge instructions',
            'You may receive instructions about medications, tests, warning signs or follow-up.',
            'Keep the paperwork until you understand what you need to do.'
          ],
          [
            '🏠',
            'Care at home',
            'You continue care at home according to the instructions you were given.',
            'Follow the medical instructions provided to you.'
          ],
          [
            '🩺',
            'Follow-up',
            'You may need follow-up with primary care, a specialist or another service.',
            'Not every follow-up appointment is automatically booked.'
          ],
          [
            '🔁',
            'Reassessment if needed',
            'You may have been told when to seek healthcare again.',
            'Follow the return precautions given by your healthcare team.'
          ]
        ],
        next: [
          '📄',
          'Read your discharge instructions',
          'Look for medications, tests, follow-up appointments and instructions about when to seek reassessment.'
        ],
        checklist: [
          ['📄', 'Discharge papers', 'Keep the instructions from your visit.'],
          ['💊', 'Medications', 'Check whether anything was started or changed.'],
          ['📅', 'Follow-up', 'Look for recommended follow-up timing.'],
          ['⚠️', 'Return precautions', 'Know when you were told to seek care again.']
        ]
      },

      waiting: {
        icon: '⏳',
        title: 'Waiting for the next step',
        intro:
          'Something was supposed to happen next, but you are not sure whether you should keep waiting or contact someone.',
        current: 2,
        stages: [
          [
            '🩺',
            'Request started',
            'A healthcare provider initiated a referral, test or other next step.',
            'Know which clinic started the process.'
          ],
          [
            '📨',
            'Request sent',
            'The request was sent to another clinic or service.',
            'Ask exactly where it was sent.'
          ],
          [
            '⏳',
            'Waiting',
            'You are currently waiting for further communication.',
            'Different services can have very different wait times.'
          ],
          [
            '📞',
            'Status clarified',
            'You contact the relevant clinic and clarify what is happening.',
            'The clinic that started the process is often a useful place to begin.'
          ],
          [
            '🧭',
            'Next step confirmed',
            'You know whether to keep waiting, book something or contact another service.',
            'Write down what you were told.'
          ]
        ],
        next: [
          '📞',
          'Contact the clinic that started the process',
          'Ask where the request was sent and whether you should continue waiting or take another action.'
        ],
        checklist: [
          ['📅', 'Approximate date', 'Know when the request was made.'],
          ['🏥', 'Referring clinic', 'Know which provider started the process.'],
          ['📨', 'Destination', 'Keep the clinic or specialist name if known.'],
          ['📞', 'Phone number', 'Make sure clinics have your current number.']
        ]
      }
    };

    const sos = {
      'no-contact': [
        'Follow up with the clinic that started the process',
        [
          'Contact the clinic or provider who initiated the referral, test, prescription, or follow-up.',
          'Ask where the request was sent or what should happen next.',
          'Confirm that your phone number and voicemail are current.'
        ],
        'Hi, I am following up because I have not been contacted yet. Could you tell me what should happen next?'
      ],

      who: [
        'Start with the clinic that initiated the process',
        [
          'Identify which provider started the referral, test, prescription, or follow-up.',
          'Contact that clinic first.',
          'Ask which clinic or service is responsible for the next step.'
        ],
        'Could you tell me who I should contact about the next step in my care?'
      ],

      paperwork: [
        'Ask the clinic that gave you the document to explain it',
        [
          'Keep the document.',
          'Identify which clinic or provider gave it to you.',
          'Ask what the document means and whether you need to do anything yourself.'
        ],
        'I received this healthcare document, but I am not sure what I am supposed to do with it. Could you explain it?'
      ],

      next: [
        'Use the next-action card as your starting point',
        [
          'Follow the next-action recommendation shown in the navigator.',
          'If the process is still unclear, contact the clinic that started it.',
          'Write down what you are told and who you spoke with.'
        ],
        'I am not sure what I should do next. Could you explain the next step to me?'
      ]
    };

    const empty = app.querySelector('[data-empty]');
    const journeyEl = app.querySelector('[data-journey]');
    const track = app.querySelector('[data-track]');
    const scenarioButtons = app.querySelectorAll('[data-scenario]');
    const checklistBox = app.querySelector('[data-checklist-box]');
    const checklistEl = app.querySelector('[data-checklist]');
    const modal = document.querySelector('[data-modal]');

    let activeKey = null;
    let selectedStage = 0;

    function renderStage(data, index) {
      const stage = data.stages[index];

      app.querySelector('[data-stage-number]').textContent =
        String(index + 1);

      app.querySelector('[data-stage-status]').textContent =
        index < data.current
          ? 'Completed stage'
          : index === data.current
            ? 'You are here'
            : 'What may happen next';

      app.querySelector('[data-stage-title]').textContent =
        stage[1];

      app.querySelector('[data-stage-description]').textContent =
        stage[2];

      app.querySelector('[data-stage-tip]').textContent =
        stage[3];
    }

    function renderTrack(data) {
      track.innerHTML = '';

      data.stages.forEach((stage, index) => {
        const status =
          index < data.current
            ? 'complete'
            : index === data.current
              ? 'current'
              : 'future';

        const button =
          document.createElement('button');

        button.type = 'button';

        button.className =
          `journey-node ${status}${index === selectedStage ? ' viewing' : ''}`;

        button.innerHTML = `
          <span class="node-circle">
            ${status === 'complete' ? '✓' : stage[0]}
          </span>

          <span class="node-label">
            ${
              status === 'complete'
                ? 'Completed'
                : status === 'current'
                  ? 'You are here'
                  : 'Next'
            }
          </span>

          <strong>${stage[1]}</strong>
        `;

        button.addEventListener('click', () => {
          selectedStage = index;
          renderTrack(data);
          renderStage(data, index);
        });

        track.appendChild(button);

        if (index < data.stages.length - 1) {
          const connector =
            document.createElement('div');

          connector.className =
            index < data.current
              ? 'connector complete'
              : 'connector';

          track.appendChild(connector);
        }
      });
    }

    function renderChecklist(items) {
      checklistEl.innerHTML = '';

      items.forEach(item => {
        const card =
          document.createElement('div');

        card.className =
          'check-item';

        card.innerHTML = `
          <span>${item[0]}</span>
          <div>
            <strong>${item[1]}</strong>
            <p>${item[2]}</p>
          </div>
        `;

        checklistEl.appendChild(card);
      });
    }

    function showJourney(key) {
      const data = journeys[key];

      if (!data) {
        return;
      }

      activeKey = key;
      selectedStage = data.current;

      scenarioButtons.forEach(button => {
        button.classList.toggle(
          'selected',
          button.dataset.scenario === key
        );
      });

      empty.classList.add('hidden');
      journeyEl.classList.remove('hidden');

      app.querySelector('[data-icon]').textContent =
        data.icon;

      app.querySelector('[data-title]').textContent =
        data.title;

      app.querySelector('[data-intro]').textContent =
        data.intro;

      app.querySelector('[data-next-icon]').textContent =
        data.next[0];

      app.querySelector('[data-next-title]').textContent =
        data.next[1];

      app.querySelector('[data-next-text]').textContent =
        data.next[2];

      renderTrack(data);
      renderStage(data, selectedStage);
      renderChecklist(data.checklist);

      checklistBox.classList.add('hidden');
    }

    scenarioButtons.forEach(button => {
      button.addEventListener('click', () => {
        showJourney(button.dataset.scenario);
      });
    });

    app
      .querySelector('[data-toggle-checklist]')
      .addEventListener('click', () => {
        checklistBox.classList.toggle('hidden');
      });

    app
      .querySelector('[data-close-checklist]')
      .addEventListener('click', () => {
        checklistBox.classList.add('hidden');
      });

    function openModal() {
      if (!activeKey) {
        return;
      }

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');

      modal
        .querySelector('[data-sos-menu]')
        .classList.remove('hidden');

      modal
        .querySelector('[data-sos-answer]')
        .classList.add('hidden');
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    }

    function showAnswer(issue) {
      const answer = sos[issue];

      if (!answer) {
        return;
      }

      modal
        .querySelector('[data-sos-menu]')
        .classList.add('hidden');

      modal
        .querySelector('[data-sos-answer]')
        .classList.remove('hidden');

      modal
        .querySelector('[data-answer-title]')
        .textContent = answer[0];

      const steps =
        modal.querySelector('[data-answer-steps]');

      steps.innerHTML = '';

      answer[1].forEach((step, index) => {
        const row =
          document.createElement('div');

        row.className =
          'answer-step';

        row.innerHTML = `
          <span>${index + 1}</span>
          <p>${step}</p>
        `;

        steps.appendChild(row);
      });

      modal
        .querySelector('[data-answer-script]')
        .textContent = `“${answer[2]}”`;
    }

    app
      .querySelector('[data-open-sos]')
      .addEventListener('click', openModal);

    modal
      .querySelectorAll('[data-issue]')
      .forEach(button => {
        button.addEventListener('click', () => {
          showAnswer(button.dataset.issue);
        });
      });

    modal
      .querySelector('[data-sos-back]')
      .addEventListener('click', () => {
        modal
          .querySelector('[data-sos-answer]')
          .classList.add('hidden');

        modal
          .querySelector('[data-sos-menu]')
          .classList.remove('hidden');
      });

    modal
      .querySelector('[data-got-it]')
      .addEventListener('click', closeModal);

    modal
      .querySelectorAll('[data-close-sos], [data-close-sos-answer]')
      .forEach(button => {
        button.addEventListener('click', closeModal);
      });

    modal.addEventListener('click', event => {
      if (event.target === modal) {
        closeModal();
      }
    });
  }

  initNavigator();

  document.addEventListener(
    'astro:page-load',
    initNavigator
  );
</script>

