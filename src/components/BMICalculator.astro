<section class="bmi-calculator" aria-labelledby="bmi-heading">
  <div class="calculator-heading">
    <p class="eyebrow">Adult screening tool</p>
    <h2 id="bmi-heading">BMI Calculator</h2>
    <p>
      Enter your height and weight to calculate your Body Mass Index.
      This calculator is intended for adults aged 20 and older.
    </p>
  </div>

  <form id="bmi-form">
    <fieldset class="unit-selector">
      <legend>Choose units</legend>

      <label>
        <input
          type="radio"
          name="units"
          value="metric"
          checked
        />
        Metric
      </label>

      <label>
        <input
          type="radio"
          name="units"
          value="imperial"
        />
        Feet and pounds
      </label>
    </fieldset>

    <div id="metric-fields" class="field-grid">
      <label>
        Height
        <span class="input-group">
          <input
            id="height-cm"
            type="number"
            min="100"
            max="250"
            step="0.1"
            inputmode="decimal"
            placeholder="170"
          />
          <span>cm</span>
        </span>
      </label>

      <label>
        Weight
        <span class="input-group">
          <input
            id="weight-kg"
            type="number"
            min="25"
            max="400"
            step="0.1"
            inputmode="decimal"
            placeholder="70"
          />
          <span>kg</span>
        </span>
      </label>
    </div>

    <div id="imperial-fields" class="field-grid hidden">
      <label>
        Height
        <div class="height-fields">
          <span class="input-group">
            <input
              id="height-ft"
              type="number"
              min="3"
              max="8"
              step="1"
              inputmode="numeric"
              placeholder="5"
            />
            <span>ft</span>
          </span>

          <span class="input-group">
            <input
              id="height-in"
              type="number"
              min="0"
              max="11"
              step="0.1"
              inputmode="decimal"
              placeholder="8"
            />
            <span>in</span>
          </span>
        </div>
      </label>

      <label>
        Weight
        <span class="input-group">
          <input
            id="weight-lb"
            type="number"
            min="55"
            max="880"
            step="0.1"
            inputmode="decimal"
            placeholder="155"
          />
          <span>lb</span>
        </span>
      </label>
    </div>

    <div class="button-row">
      <button type="submit">Calculate BMI</button>
      <button type="button" class="reset-button" id="reset-bmi">
        Reset
      </button>
    </div>

    <p id="bmi-error" class="error-message" role="alert"></p>
  </form>

  <section id="bmi-result" class="result hidden" aria-live="polite">
    <p class="result-label">Your estimated BMI</p>
    <p class="result-number" id="bmi-number">—</p>
    <p class="result-category" id="bmi-category"></p>
    <p class="result-explanation" id="bmi-explanation"></p>
  </section>

  <div class="category-table">
    <h3>Adult BMI categories</h3>

    <div class="category-row">
      <span>Below 18.5</span>
      <strong>Underweight</strong>
    </div>

    <div class="category-row">
      <span>18.5–24.9</span>
      <strong>Healthy weight</strong>
    </div>

    <div class="category-row">
      <span>25.0–29.9</span>
      <strong>Overweight</strong>
    </div>

    <div class="category-row">
      <span>30.0 or above</span>
      <strong>Obesity</strong>
    </div>
  </div>

  <aside class="calculator-disclaimer">
    <strong>Important</strong>
    <p>
      BMI is a screening measure and does not diagnose health or disease.
      It may not accurately reflect health for everyone, including people with
      high muscle mass, during pregnancy, or in some older adults. Speak with a
      healthcare professional for advice based on your individual health.
    </p>
  </aside>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#bmi-form');
  const metricFields =
    document.querySelector<HTMLElement>('#metric-fields');
  const imperialFields =
    document.querySelector<HTMLElement>('#imperial-fields');
  const result = document.querySelector<HTMLElement>('#bmi-result');
  const bmiNumber = document.querySelector<HTMLElement>('#bmi-number');
  const bmiCategory =
    document.querySelector<HTMLElement>('#bmi-category');
  const bmiExplanation =
    document.querySelector<HTMLElement>('#bmi-explanation');
  const errorMessage =
    document.querySelector<HTMLElement>('#bmi-error');
  const resetButton =
    document.querySelector<HTMLButtonElement>('#reset-bmi');

  const unitInputs =
    document.querySelectorAll<HTMLInputElement>('input[name="units"]');

  function getSelectedUnits(): string {
    return (
      document.querySelector<HTMLInputElement>(
        'input[name="units"]:checked'
      )?.value ?? 'metric'
    );
  }

  function showUnits(units: string): void {
    const useMetric = units === 'metric';

    metricFields?.classList.toggle('hidden', !useMetric);
    imperialFields?.classList.toggle('hidden', useMetric);

    errorMessage!.textContent = '';
    result?.classList.add('hidden');
  }

  function getCategory(bmi: number): {
    label: string;
    explanation: string;
  } {
    if (bmi < 18.5) {
      return {
        label: 'Underweight range',
        explanation:
          'Your BMI is below the usual healthy-weight range for adults.',
      };
    }

    if (bmi < 25) {
      return {
        label: 'Healthy-weight range',
        explanation:
          'Your BMI is within the usual healthy-weight range for adults.',
      };
    }

    if (bmi < 30) {
      return {
        label: 'Overweight range',
        explanation:
          'Your BMI is within the overweight range for adults.',
      };
    }

    return {
      label: 'Obesity range',
      explanation:
        'Your BMI is within the obesity range for adults.',
    };
  }

  unitInputs.forEach((input) => {
    input.addEventListener('change', () => {
      showUnits(input.value);
    });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    errorMessage!.textContent = '';

    const units = getSelectedUnits();
    let bmi = 0;

    if (units === 'metric') {
      const heightCm = Number(
        document.querySelector<HTMLInputElement>('#height-cm')?.value
      );

      const weightKg = Number(
        document.querySelector<HTMLInputElement>('#weight-kg')?.value
      );

      if (
        !heightCm ||
        !weightKg ||
        heightCm < 100 ||
        heightCm > 250 ||
        weightKg < 25 ||
        weightKg > 400
      ) {
        errorMessage!.textContent =
          'Please enter a valid height and weight.';
        result?.classList.add('hidden');
        return;
      }

      const heightM = heightCm / 100;
      bmi = weightKg / (heightM * heightM);
    } else {
      const feet = Number(
        document.querySelector<HTMLInputElement>('#height-ft')?.value
      );

      const inches = Number(
        document.querySelector<HTMLInputElement>('#height-in')?.value
      );

      const weightLb = Number(
        document.querySelector<HTMLInputElement>('#weight-lb')?.value
      );

      const totalInches = feet * 12 + inches;

      if (
        !feet ||
        inches < 0 ||
        inches > 11 ||
        !weightLb ||
        totalInches <= 0
      ) {
        errorMessage!.textContent =
          'Please enter a valid height and weight.';
        result?.classList.add('hidden');
        return;
      }

      bmi = (weightLb / (totalInches * totalInches)) * 703;
    }

    const roundedBMI = Math.round(bmi * 10) / 10;
    const category = getCategory(roundedBMI);

    bmiNumber!.textContent = roundedBMI.toFixed(1);
    bmiCategory!.textContent = category.label;
    bmiExplanation!.textContent = category.explanation;

    result?.classList.remove('hidden');
  });

  resetButton?.addEventListener('click', () => {
    form?.reset();
    showUnits('metric');
  });
</script>

<style>
