---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    icon: '⚖️',
    title: 'Adult BMI Calculator',
    description:
      'Calculate an estimated Body Mass Index using metric or imperial measurements.',
    href: '/tools/bmi',
  },
  {
  icon: '❤️',
  title: 'Blood Pressure Checker',
  description:
    'Enter a blood pressure reading and learn what the systolic and diastolic numbers may mean.',
  href: '/tools/blood-pressure',
},
];
---

<Layout title="Health Tools | Newcomer Health Literacy Initiative">
  <main class="tools-page">
    <section class="page-heading">
      <p class="eyebrow">Interactive tools</p>
      <h1>Health tools</h1>
      <p>
        Use these simple educational tools to better understand common health
        measurements. They do not replace advice from a healthcare professional.
      </p>
    </section>

    <section class="tool-grid" aria-label="Available health tools">
      {
        tools.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <span class="tool-icon" aria-hidden="true">{tool.icon}</span>

            <div>
              <h2>{tool.title}</h2>
              <p>{tool.description}</p>
              <span class="tool-link">Open tool →</span>
            </div>
          </a>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .tools-page {
    width: min(1050px, 90%);
    min-height: 70vh;
    margin: 0 auto;
    padding: 5rem 0 7rem;
  }

  .page-heading {
    max-width: 720px;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: #14766f;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1rem;
    color: #16302f;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1.05;
  }

  .page-heading p:last-child {
    color: #586b68;
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .tool-card {
    display: flex;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid #dce8e6;
    border-radius: 18px;
    background: white;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(22, 48, 47, 0.06);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .tool-card:hover {
    border-color: #8dc5c8;
    box-shadow: 0 16px 38px rgba(22, 48, 47, 0.1);
    transform: translateY(-4px);
  }

  .tool-icon {
    flex-shrink: 0;
    font-size: 2.25rem;
    line-height: 1;
  }

  .tool-card h2 {
    margin: 0 0 0.75rem;
    color: #16302f;
    font-size: 1.35rem;
  }

  .tool-card p {
    margin: 0 0 1rem;
    color: #60716f;
    line-height: 1.65;
  }

  .tool-link {
    color: #14766f;
    font-weight: 750;
  }

  @media (max-width: 700px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>


