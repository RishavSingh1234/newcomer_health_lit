  </div>


  <!-- =====================================================
       DISCLAIMER
  ====================================================== -->
  <aside class="module-disclaimer">
    <strong>About this learning module</strong>

    <p>
      This module provides general educational information about navigating
      healthcare in British Columbia. Eligibility, coverage and available
      services can differ between individuals and can change over time.
      Confirm information about your own coverage or medical needs with the
      appropriate B.C. healthcare service or government program.
    </p>
  </aside>
</ResourceLayout>


<script>
  function initializeLearningModule() {
    const root = document.querySelector('[data-learning-module]');

    if (!root || root.dataset.initialized === 'true') {
      return;
    }

    root.dataset.initialized = 'true';

    const STORAGE_KEY =
      'bc-healthcare-module-progress-v2';

    const TOTAL_REQUIRED_STEPS = 8;
    const QUIZ_INDEX = 7;
    const COMPLETION_INDEX = 8;

    const welcome =
      root.querySelector('[data-welcome]');

    const shell =
      root.querySelector('[data-module-shell]');

    const startButton =
      root.querySelector('[data-start]');

    const resetButton =
      root.querySelector('[data-reset]');

    const restartButton =
      root.querySelector('[data-restart]');

    const savedProgress =
      root.querySelector('[data-saved-progress]');

    const savedProgressText =
      root.querySelector('[data-saved-progress-text]');

    const lessons =
      Array.from(
        root.querySelectorAll('[data-lesson]')
      );

    const stepButtons =
      Array.from(
        root.querySelectorAll('[data-step]')
      );

    const previousButton =
      root.querySelector('[data-prev]');

    const nextButton =
      root.querySelector('[data-next]');

    const nextText =
      root.querySelector('[data-next-text]');

    const controls =
      root.querySelector('[data-controls]');

    const progressFill =
      root.querySelector('[data-progress-fill]');

    const progressTrack =
      root.querySelector('[data-progress-track]');

    const progressLabel =
      root.querySelector('[data-progress-label]');

    const progressPercent =
      root.querySelector('[data-progress-percent]');

    const quiz =
      root.querySelector('[data-quiz]');

    const quizResult =
      root.querySelector('[data-quiz-result]');

    const finalScore =
      root.querySelector('[data-final-score]');


    /* =====================================================
       CERTIFICATE ELEMENTS
    ====================================================== */

    const certificateNameInput =
      root.querySelector(
        '[data-certificate-name-input]'
      );

    const generateCertificateButton =
      root.querySelector(
        '[data-generate-certificate]'
      );

    const certificateError =
      root.querySelector(
        '[data-certificate-error]'
      );

    const certificateArea =
      root.querySelector(
        '[data-certificate-area]'
      );

    const certificateName =
      root.querySelector(
        '[data-certificate-name]'
      );

    const certificateDate =
      root.querySelector(
        '[data-certificate-date]'
      );

    const certificateScore =
      root.querySelector(
        '[data-certificate-score]'
      );

    const printCertificateButton =
      root.querySelector(
        '[data-print-certificate]'
      );

    const editCertificateButton =
      root.querySelector(
        '[data-edit-certificate]'
      );


    /* =====================================================
       STATE
    ====================================================== */

    let state = {
      current: 0,
      completed: [],
      quizPassed: false,
      quizScore: null,
      finished: false,
      certificateName: '',
      completionDate: '',
    };


    /* =====================================================
       STORAGE
    ====================================================== */

    function loadState() {
      try {
        const stored =
          localStorage.getItem(STORAGE_KEY);

        if (stored) {
          const parsed =
            JSON.parse(stored);

          state = {
            ...state,
            ...parsed,
          };
        }
      } catch (error) {
        console.warn(
          'Could not load module progress.',
          error
        );
      }

      if (!Array.isArray(state.completed)) {
        state.completed = [];
      }

      if (
        typeof state.current !== 'number' ||
        state.current < 0 ||
        state.current > COMPLETION_INDEX
      ) {
        state.current = 0;
      }
    }


    function saveState() {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify(state)
        );
      } catch (error) {
        console.warn(
          'Could not save module progress.',
          error
        );
      }
    }


    /* =====================================================
       HELPERS
    ====================================================== */

    function completedCount() {
      return state.completed.filter(
        (step) =>
          step >= 0 &&
          step < TOTAL_REQUIRED_STEPS
      ).length;
    }


    function markComplete(index) {
      if (
        index >= 0 &&
        index < TOTAL_REQUIRED_STEPS &&
        !state.completed.includes(index)
      ) {
        state.completed.push(index);
      }

      saveState();
    }


    function formatDate(dateString) {
      if (!dateString) {
        return '';
      }

      const date =
        new Date(dateString);

      return date.toLocaleDateString(
        undefined,
        {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        }
      );
    }


    /* =====================================================
       WELCOME
    ====================================================== */

    function updateWelcome() {
      const completed =
        completedCount();

      if (state.finished) {
        savedProgress.hidden = false;

        savedProgressText.textContent =
          'You previously completed this module.';

        startButton.innerHTML =
          `
            <span>View Completed Module</span>
            <span class="button-arrow">→</span>
          `;

        return;
      }

      if (
        completed > 0 ||
        state.current > 0
      ) {
        savedProgress.hidden = false;

        savedProgressText.textContent =
          `You completed ${completed} of ${TOTAL_REQUIRED_STEPS} module steps.`;

        startButton.innerHTML =
          `
            <span>Continue Module</span>
            <span class="button-arrow">→</span>
          `;
      } else {
        savedProgress.hidden = true;

        startButton.innerHTML =
          `
            <span>Start Module</span>
            <span class="button-arrow">→</span>
          `;
      }
    }


    function showModule() {
      welcome.hidden = true;
      shell.hidden = false;

      if (state.finished) {
        state.current =
          COMPLETION_INDEX;
      }

      renderLesson();
    }


    /* =====================================================
       LESSON RENDERING
    ====================================================== */

    function renderLesson() {
      state.current =
        Math.max(
          0,
          Math.min(
            state.current,
            COMPLETION_INDEX
          )
        );

      lessons.forEach((lesson) => {
        const index =
          Number(
            lesson.dataset.lesson
          );

        lesson.hidden =
          index !== state.current;
      });


      stepButtons.forEach((button) => {
        const index =
          Number(
            button.dataset.step
          );

        const completed =
          state.completed.includes(index);

        button.classList.toggle(
          'active',
          index === state.current
        );

        button.classList.toggle(
          'complete',
          completed
        );

        const circle =
          button.querySelector(
            '.step-circle'
          );

        if (circle) {
          if (completed) {
            circle.textContent = '✓';
          } else if (
            index === QUIZ_INDEX
          ) {
            circle.textContent = '✓';
          } else {
            circle.textContent =
              String(index + 1);
          }
        }
      });


      updateProgress();


      if (
        state.current ===
        COMPLETION_INDEX
      ) {
        controls.hidden = true;

        updateCompletionScreen();
        return;
      }


      controls.hidden = false;

      previousButton.disabled =
        state.current === 0;


      if (
        state.current === QUIZ_INDEX
      ) {
        nextText.textContent =
          state.quizPassed
            ? 'Complete Module'
            : 'Complete Knowledge Check';

        nextButton.disabled =
          !state.quizPassed;
      } else {
        nextText.textContent =
          'Next';

        nextButton.disabled =
          false;
      }


      window.scrollTo({
        top:
          root.getBoundingClientRect().top +
          window.scrollY -
          20,

        behavior: 'smooth',
      });

      saveState();
    }


    /* =====================================================
       PROGRESS BAR
    ====================================================== */

    function updateProgress() {
      const completed =
        completedCount();

      const percentage =
        state.finished
          ? 100
          : Math.round(
              (
                completed /
                TOTAL_REQUIRED_STEPS
              ) *
                100
            );


      progressFill.style.width =
        `${percentage}%`;

      progressTrack.setAttribute(
        'aria-valuenow',
        String(percentage)
      );

      progressPercent.textContent =
        `${percentage}%`;


      if (
        state.current === QUIZ_INDEX
      ) {
        progressLabel.textContent =
          'Knowledge Check';
      } else if (
        state.current ===
        COMPLETION_INDEX
      ) {
        progressLabel.textContent =
          'Module Complete';
      } else {
        progressLabel.textContent =
          `Lesson ${state.current + 1} of 7`;
      }
    }


    /* =====================================================
       MODULE BUTTONS
    ====================================================== */

    startButton.addEventListener(
      'click',
      showModule
    );


    resetButton.addEventListener(
      'click',
      () => {
        const confirmed =
          window.confirm(
            'Reset all progress for this learning module?'
          );

        if (!confirmed) {
          return;
        }


        localStorage.removeItem(
          STORAGE_KEY
        );


        state = {
          current: 0,
          completed: [],
          quizPassed: false,
          quizScore: null,
          finished: false,
          certificateName: '',
          completionDate: '',
        };


        if (quiz) {
          quiz.reset();
        }


        if (quizResult) {
          quizResult.hidden = true;
        }


        root
          .querySelectorAll(
            '[data-question-feedback]'
          )
          .forEach((feedback) => {
            feedback.textContent = '';

            feedback.className =
              'question-feedback';
          });


        certificateArea.hidden = true;

        certificateNameInput.value = '';

        updateWelcome();
      }
    );


    previousButton.addEventListener(
      'click',
      () => {
        if (state.current <= 0) {
          return;
        }

        state.current -= 1;

        renderLesson();
      }
    );


    nextButton.addEventListener(
      'click',
      () => {
        if (
          state.current === QUIZ_INDEX
        ) {
          if (!state.quizPassed) {
            return;
          }

          markComplete(
            QUIZ_INDEX
          );

          state.finished = true;

          state.current =
            COMPLETION_INDEX;


          if (!state.completionDate) {
            state.completionDate =
              new Date().toISOString();
          }


          saveState();

          renderLesson();

          return;
        }


        markComplete(
          state.current
        );


        if (
          state.current < QUIZ_INDEX
        ) {
          state.current += 1;
        }


        renderLesson();
      }
    );


    stepButtons.forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          const index =
            Number(
              button.dataset.step
            );

          state.current =
            index;

          renderLesson();
        }
      );
    });


    restartButton?.addEventListener(
      'click',
      () => {
        state.current = 0;

        saveState();

        renderLesson();
      }
    );


    /* =====================================================
       INTERACTIVE CARE SCENARIO
    ====================================================== */

    const scenarioButtons =
      root.querySelectorAll(
        '[data-scenario-choice]'
      );

    const scenarioFeedback =
      root.querySelector(
        '[data-scenario-feedback]'
      );


    scenarioButtons.forEach(
      (button) => {
        button.addEventListener(
          'click',
          () => {
            const choice =
              button.dataset.scenarioChoice;


            scenarioButtons.forEach(
              (item) => {
                item.classList.remove(
                  'selected-correct',
                  'selected-wrong'
                );
              }
            );


            scenarioFeedback.hidden =
              false;


            if (
              choice === 'primary'
            ) {
              button.classList.add(
                'selected-correct'
              );

              scenarioFeedback.className =
                'scenario-feedback feedback-correct';

              scenarioFeedback.innerHTML =
                `
                  <strong>✓ Good choice.</strong>

                  <p>
                    Because the problem described is not currently
                    life-threatening, a walk-in clinic or other primary-care
                    option is more appropriate than 9-1-1. If you are unsure
                    how urgent a problem is, 8-1-1 can also help guide you.
                  </p>
                `;
            } else if (
              choice === '911'
            ) {
              button.classList.add(
                'selected-wrong'
              );

              scenarioFeedback.className =
                'scenario-feedback feedback-review';

              scenarioFeedback.innerHTML =
                `
                  <strong>Think again.</strong>

                  <p>
                    9-1-1 is intended for emergencies. The scenario does not
                    describe signs of a life-threatening emergency. Primary or
                    urgent care is a more reasonable choice based on the
                    information given.
                  </p>
                `;
            } else {
              button.classList.add(
                'selected-wrong'
              );

              scenarioFeedback.className =
                'scenario-feedback feedback-review';

              scenarioFeedback.innerHTML =
                `
                  <strong>Not quite.</strong>

                  <p>
                    You can still access healthcare even if you do not have a
                    regular family doctor. Walk-in clinics, UPCCs and other
                    services may be available.
                  </p>
                `;
            }
          }
        );
      }
    );


    /* =====================================================
       KNOWLEDGE CHECK
    ====================================================== */

    quiz?.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();


        const questions =
          Array.from(
            quiz.querySelectorAll(
              '[data-question]'
            )
          );


        let score = 0;
        let unanswered = 0;


        questions.forEach(
          (question) => {
            const correct =
              question.dataset.correct;

            const selected =
              question.querySelector(
                'input[type="radio"]:checked'
              );

            const feedback =
              question.querySelector(
                '[data-question-feedback]'
              );


            if (!selected) {
              unanswered += 1;

              feedback.textContent =
                'Please choose an answer.';

              feedback.className =
                'question-feedback question-unanswered';

              return;
            }


            if (
              selected.value === correct
            ) {
              score += 1;

              feedback.textContent =
                '✓ Correct';

              feedback.className =
                'question-feedback question-correct';
            } else {
              feedback.textContent =
                'Review this topic and try again.';

              feedback.className =
                'question-feedback question-wrong';
            }
          }
        );


        if (unanswered > 0) {
          quizResult.hidden =
            false;

          quizResult.className =
            'quiz-result quiz-result-review';

          quizResult.innerHTML =
            `
              <div class="result-icon">!</div>

              <div>
                <strong>Please answer all five questions.</strong>

                <p>
                  You still have ${unanswered}
                  unanswered question${unanswered === 1 ? '' : 's'}.
                </p>
              </div>
            `;

          return;
        }


        state.quizScore =
          score;


        if (score >= 4) {
          state.quizPassed =
            true;

          markComplete(
            QUIZ_INDEX
          );


          quizResult.hidden =
            false;

          quizResult.className =
            'quiz-result quiz-result-pass';

          quizResult.innerHTML =
            `
              <div class="result-score">${score}/5</div>

              <div>
                <strong>Knowledge check passed!</strong>

                <p>
                  Nice work. You can now complete the module.
                </p>
              </div>
            `;
        } else {
          state.quizPassed =
            false;


          quizResult.hidden =
            false;

          quizResult.className =
            'quiz-result quiz-result-review';

          quizResult.innerHTML =
            `
              <div class="result-score">${score}/5</div>

              <div>
                <strong>Almost there.</strong>

                <p>
                  Review the questions above and try again.
                  You need 4/5 to complete the module.
                </p>
              </div>
            `;
        }


        saveState();

        renderLesson();
      }
    );


    /* =====================================================
       COMPLETION SCREEN
    ====================================================== */

    function updateCompletionScreen() {
      if (
        state.quizScore !== null
      ) {
        finalScore.textContent =
          `${state.quizScore}/5`;
      }


      if (state.certificateName) {
        certificateNameInput.value =
          state.certificateName;

        showCertificate(
          state.certificateName
        );
      }
    }


    /* =====================================================
       CERTIFICATE
    ====================================================== */

    function showCertificate(name) {
      const cleanName =
        name.trim();


      if (!cleanName) {
        return;
      }


      state.certificateName =
        cleanName;


      if (!state.completionDate) {
        state.completionDate =
          new Date().toISOString();
      }


      certificateName.textContent =
        cleanName;


      certificateDate.textContent =
        formatDate(
          state.completionDate
        );


      certificateScore.textContent =
        state.quizScore !== null
          ? `${state.quizScore}/5`
          : 'Passed';


      certificateArea.hidden =
        false;


      certificateError.hidden =
        true;


      saveState();


      setTimeout(
        () => {
          certificateArea.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
          });
        },
        100
      );
    }


    generateCertificateButton?.addEventListener(
      'click',
      () => {
        const name =
          certificateNameInput.value.trim();


        if (!name) {
          certificateError.hidden =
            false;

          certificateNameInput.focus();

          return;
        }


        showCertificate(name);
      }
    );


    certificateNameInput?.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === 'Enter'
        ) {
          event.preventDefault();

          generateCertificateButton.click();
        }
      }
    );


    editCertificateButton?.addEventListener(
      'click',
      () => {
        certificateArea.hidden =
          true;

        certificateNameInput.focus();

        certificateNameInput.select();
      }
    );


    printCertificateButton?.addEventListener(
      'click',
      () => {
        document.body.classList.add(
          'printing-certificate'
        );

        window.print();
      }
    );


    window.addEventListener(
      'afterprint',
      () => {
        document.body.classList.remove(
          'printing-certificate'
        );
      }
    );


    /* =====================================================
       INITIALIZE
    ====================================================== */

    loadState();

    updateWelcome();


    if (state.finished) {
      state.current =
        COMPLETION_INDEX;
    }
  }


  initializeLearningModule();


  document.addEventListener(
    'astro:page-load',
    initializeLearningModule
  );
</script>


