---
interface Props {
  title: string;
  description: string;
  href: string;
  source?: string;
  icon?: string;
}

const {
  title,
  description,
  href,
  source = 'External resource',
  icon = '🔗',
} = Astro.props;
---

<a
  href={href}
  class="external-resource"
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="resource-icon" aria-hidden="true">{icon}</div>

  <div class="resource-content">
    <span class="resource-source">{source}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="resource-link">Visit resource ↗</span>
  </div>
</a>

<style>
  .external-resource {
    display: flex;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid #dce8e6;
    border-radius: 18px;
    background: #f8fbfa;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .external-resource:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(22, 48, 47, 0.1);
  }

  .resource-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .resource-source {
    color: #14766f;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .resource-content h3 {
    margin: 0.35rem 0 0.5rem;
  }

  .resource-content p {
    margin: 0 0 0.75rem;
    line-height: 1.65;
  }

  .resource-link {
    color: #14766f;
    font-weight: 700;
  }
</style>