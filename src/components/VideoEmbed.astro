---
interface Props {
  title: string;
  videoId: string;
  description?: string;
}

const { title, videoId, description } = Astro.props;
---

<section class="video-section">
  <div class="video-heading">
    <span class="video-label">Watch</span>

    <h2>{title}</h2>

    {description && <p>{description}</p>}
  </div>

  <div class="video-wrapper">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${videoId}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>

  <p class="video-note">
    Prefer reading? The key information from this video is summarized below.
  </p>
</section>

<style>
.video-section {
  margin: 3rem 0;
  padding: 2rem;
  background: #f4faf9;
  border: 1px solid #dce8e6;
  border-radius: 20px;
}

.video-heading {
  max-width: 750px;
  margin-bottom: 1.5rem;
}

.video-label {
  display: inline-block;
  margin-bottom: 0.5rem;
  color: #14766f;
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.video-heading h2 {
  margin: 0 0 0.75rem;
}

.video-heading p {
  margin: 0;
  line-height: 1.7;
}

.video-wrapper {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 16px;
  background: #111;
  box-shadow: 0 10px 30px rgba(22,48,47,.12);
}

.video-wrapper iframe {
  width: 100%;
  height: 100%;
  border: 0;
}

.video-note {
  margin-top: 1rem;
  color: #526664;
  font-size: .95rem;
}
</style>