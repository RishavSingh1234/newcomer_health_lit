     IMPORTANT / EXAMPLE
  ====================================================== */

  .important-box {
    margin: 1.5rem 0;

    padding: 1.5rem;

    border-left: 5px solid #dfa82f;

    border-radius: 13px;

    background: #fff8e9;
  }

  .important-heading {
    display: flex;

    gap: 0.65rem;

    align-items: center;

    margin-bottom: 0.7rem;
  }

  .important-box p + p {
    margin-top: 0.8rem !important;
  }

  .medication-box {
    border-left-color: #14766f;

    background: #eff9f7;
  }

  .example {
    margin: 1.2rem 0;

    padding: 1.35rem;

    border: 1px solid #e0e8e7;

    border-radius: 15px;

    background: #f7faf9;
  }

  .example-label,
  .activity-label,
  .certificate-eyebrow {
    display: block;

    margin-bottom: 0.45rem;

    color: #14766f;

    font-size: 0.72rem;

    font-weight: 900;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }

  .fine-print {
    font-size: 0.9rem;

    font-style: italic;
  }


  /* =====================================================
     STEPS
  ====================================================== */

  .steps {
    display: grid;

    gap: 0.85rem;

    margin: 1.5rem 0;
  }

  .step {
    display: flex;

    gap: 1rem;

    padding: 1.2rem;

    border: 1px solid #dce8e6;

    border-radius: 14px;

    background: white;
  }

  .step-number {
    display: flex;

    width: 2.1rem;
    height: 2.1rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        #14766f,
        #22a396
      );

    color: white;

    font-weight: 900;

    box-shadow:
      0 4px 10px rgba(20, 118, 111, 0.16);
  }

  .step p {
    margin-top: 0.25rem !important;
  }


  /* =====================================================
     CARE OPTIONS
  ====================================================== */

  .care-options {
    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 1rem;

    margin: 1.5rem 0;
  }

  .care-card {
    padding: 1.35rem;

    border: 1px solid #dce8e6;

    border-radius: 16px;

    background: white;

    box-shadow:
      0 5px 16px rgba(22, 48, 47, 0.035);
  }

  .care-icon {
    font-size: 1.8rem;
  }

  .care-card h3 {
    margin: 0.5rem 0;

    color: #123b4a;
  }

  .best-for {
    display: block;

    margin-bottom: 0.35rem;

    color: #14766f;

    font-size: 0.72rem;

    font-weight: 900;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  .emergency-card {
    border-color: #eac3c3;

    background: #fffafa;
  }

  .notice {
    margin-top: 1.5rem;

    padding: 1.35rem;

    border-left: 4px solid #14766f;

    border-radius: 11px;

    background: #eff9f7;
  }


  /* =====================================================
     SCENARIO
  ====================================================== */

  .scenario-box {
    margin: 2rem 0;

    padding: 1.6rem;

    border: 2px solid #cce3df;

    border-radius: 19px;

    background:
      linear-gradient(
        145deg,
        #fbfefd,
        #f5fbfa
      );
  }

  .scenario-header {
    display: flex;

    gap: 0.8rem;

    margin-bottom: 1rem;
  }

  .scenario-icon {
    display: flex;

    width: 2.7rem;
    height: 2.7rem;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: white;

    font-size: 1.5rem;

    box-shadow:
      0 4px 12px rgba(22, 48, 47, 0.06);
  }

  .scenario-header h3 {
    margin: 0;

    color: #123b4a;
  }

  .scenario-question {
    margin-top: 1rem !important;

    font-weight: 800;
  }

  .scenario-options {
    display: grid;

    gap: 0.7rem;

    margin-top: 1rem;
  }

  .scenario-choice {
    display: flex;

    gap: 0.8rem;

    align-items: center;

    padding: 1rem;

    border: 1px solid #d2e1df;

    border-radius: 12px;

    background: white;

    color: #395b60;

    text-align: left;

    cursor: pointer;

    font-weight: 700;

    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }

  .scenario-choice:hover {
    transform: translateY(-1px);

    border-color: #86bdb7;

    background: #f6fbfa;

    box-shadow:
      0 5px 12px rgba(22, 48, 47, 0.06);
  }

  .scenario-choice.selected-correct {
    border-color: #4b9b78;

    background: #edf9f2;
  }

  .scenario-choice.selected-wrong {
    border-color: #d59a62;

    background: #fff8ef;
  }

  .scenario-feedback {
    margin-top: 1rem;

    padding: 1.2rem;

    border-radius: 13px;
  }

  .scenario-feedback p {
    margin-top: 0.35rem !important;
  }

  .feedback-correct {
    background: #edf9f2;

    color: #315e49;
  }

  .feedback-review {
    background: #fff8ef;

    color: #70563a;
  }


  /* =====================================================
     JOURNEY
  ====================================================== */

  .journey {
    display: flex;

    gap: 0.55rem;

    align-items: stretch;

    margin: 1.6rem 0;
  }

  .journey-item {
    flex: 1;

    padding: 1rem;

    border: 1px solid #dce8e6;

    border-radius: 14px;

    background: white;

    text-align: center;
  }

  .journey-item span {
    display: flex;

    width: 2rem;
    height: 2rem;

    align-items: center;
    justify-content: center;

    margin: 0 auto 0.6rem;

    border-radius: 50%;

    background: #eaf7f6;

    color: #14766f;

    font-weight: 900;
  }

  .journey-item strong {
    font-size: 0.88rem;
  }

  .journey-arrow {
    display: flex;

    align-items: center;

    color: #14766f;

    font-weight: 900;
  }


  /* =====================================================
     LANGUAGE
  ====================================================== */

  .language-card {
    display: flex;

    gap: 1.1rem;

    margin: 1.5rem 0;

    padding: 1.45rem;

    border: 1px solid #d3e8e4;

    border-radius: 16px;

    background:
      linear-gradient(
        145deg,
        #eff9f7,
        #f8fcfb
      );
  }

  .language-icon {
    display: flex;

    width: 3rem;
    height: 3rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: white;

    font-size: 1.8rem;

    box-shadow:
      0 4px 12px rgba(22, 48, 47, 0.06);
  }

  .language-card h3 {
    margin: 0 0 0.5rem;

    color: #123b4a;
  }


  /* =====================================================
     FIVE THINGS
  ====================================================== */

  .five-things {
    margin: 2rem 0;

    padding: 1.5rem;

    border: 1px solid #dde9e7;

    border-radius: 18px;

    background: #f7faf9;
  }

  .five-things-title {
    display: flex;

    gap: 0.6rem;

    align-items: center;

    margin-bottom: 0.6rem;
  }

  .five-things-title h3 {
    margin: 0;

    color: #123b4a;
  }

  .memory-row {
    display: flex;

    gap: 0.9rem;

    align-items: center;

    padding: 0.75rem 0;

    border-bottom: 1px solid #e1ebea;
  }

  .memory-row:last-child {
    border-bottom: 0;
  }

  .memory-row > span {
    display: flex;

    width: 1.9rem;
    height: 1.9rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        #14766f,
        #22a396
      );

    color: white;

    font-size: 0.8rem;

    font-weight: 900;
  }


  /* =====================================================
     QUIZ INTRO
  ====================================================== */

  .quiz-intro-card {
    display: flex;

    gap: 0.9rem;

    align-items: center;

    margin-bottom: 1.5rem;

    padding: 1.15rem 1.3rem;

    border: 1px solid #ddd1eb;

    border-radius: 15px;

    background: #faf7fd;
  }

  .quiz-intro-icon {
    display: flex;

    width: 2.5rem;
    height: 2.5rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: white;

    font-size: 1.4rem;
  }

  .quiz-intro-card p {
    margin-top: 0.2rem !important;
  }


  /* =====================================================
     QUIZ QUESTIONS
  ====================================================== */

  .quiz-question {
    margin: 0 0 1.5rem;

    padding: 1.45rem;

    border: 1px solid #dce8e6;

    border-radius: 17px;

    background: white;

    box-shadow:
      0 5px 16px rgba(22, 48, 47, 0.035);
  }

  .quiz-question legend {
    width: 100%;

    padding: 0 0 1rem;

    color: #123b4a;

    font-weight: 800;

    line-height: 1.5;
  }

  .quiz-question legend span {
    display: inline-flex;

    width: 1.9rem;
    height: 1.9rem;

    align-items: center;
    justify-content: center;

    margin-right: 0.45rem;

    border-radius: 50%;

    background: #f0eafb;

    color: #7454a3;

    font-size: 0.8rem;
  }

  .quiz-question label {
    display: flex;

    gap: 0.7rem;

    align-items: flex-start;

    margin-bottom: 0.65rem;

    padding: 0.85rem;

    border: 1px solid transparent;

    border-radius: 11px;

    cursor: pointer;

    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .quiz-question label:hover {
    border-color: #e0d6ec;

    background: #faf8fc;
  }

  .quiz-question input {
    margin-top: 0.25rem;

    accent-color: #7554a5;
  }

  .question-feedback {
    min-height: 1.2rem;

    margin-top: 0.8rem;

    font-size: 0.86rem;

    font-weight: 800;
  }

  .question-correct {
    color: #367e5b;
  }

  .question-wrong {
    color: #9c612e;
  }

  .question-unanswered {
    color: #a06231;
  }

  .submit-quiz {
    margin-top: 0.5rem;
  }


  /* =====================================================
     QUIZ RESULT
  ====================================================== */

  .quiz-result {
    display: flex;

    gap: 1rem;

    align-items: center;

    margin-top: 1.3rem;

    padding: 1.4rem;

    border-radius: 15px;
  }

  .quiz-result p {
    margin-top: 0.25rem !important;
  }

  .quiz-result-pass {
    border: 1px solid #bee0cd;

    background: #edf9f2;

    color: #315e49;
  }

  .quiz-result-review {
    border: 1px solid #efd9bd;

    background: #fff8ef;

    color: #70563a;
  }

  .result-score,
  .result-icon {
    display: flex;

    min-width: 3.1rem;
    height: 3.1rem;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: rgba(255, 255, 255, 0.7);

    font-size: 1.25rem;

    font-weight: 900;
  }


  /* =====================================================
     BOTTOM CONTROLS
  ====================================================== */

  .module-controls {
    display: flex;

    justify-content: space-between;

    gap: 1rem;

    margin-top: 2.5rem;

    padding-top: 1.5rem;

    border-top: 1px solid #dce8e6;
  }

  .navigation-button {
    min-width: 115px;
  }


  /* =====================================================
     COMPLETION
  ====================================================== */

  .completion-screen {
    padding: 2.2rem 0 1rem;

    text-align: center;
  }

  .celebration {
    position: relative;

    width: 130px;

    margin: 0 auto;
  }

  .completion-icon {
    display: flex;

    width: 5rem;
    height: 5rem;

    align-items: center;
    justify-content: center;

    margin: 0 auto 1.2rem;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        #14766f,
        #22a396
      );

    color: white;

    font-size: 2.3rem;

    font-weight: 900;

    box-shadow:
      0 12px 28px rgba(20, 118, 111, 0.24);

    animation:
      completionPop 0.5s ease;
  }

  @keyframes completionPop {
    0% {
      transform: scale(0.7);

      opacity: 0;
    }

    70% {
      transform: scale(1.08);
    }

    100% {
      transform: scale(1);

      opacity: 1;
    }
  }

  .confetti {
    position: absolute;

    color: #c8933e;

    animation:
      confettiFloat 2.3s ease-in-out infinite;
  }

  .confetti-1 {
    top: 5px;

    left: 2px;
  }

  .confetti-2 {
    top: 28px;

    right: 2px;

    color: #22a396;

    animation-delay: 0.3s;
  }

  .confetti-3 {
    top: 63px;

    left: -5px;

    color: #7554a5;

    animation-delay: 0.6s;
  }

  .confetti-4 {
    top: 2px;

    right: 17px;

    animation-delay: 0.8s;
  }

  @keyframes confettiFloat {
    0%,
    100% {
      transform:
        translateY(0)
        rotate(0deg);
    }

    50% {
      transform:
        translateY(-5px)
        rotate(15deg);
    }
  }

  .completion-eyebrow {
    color: #14766f !important;

    font-size: 0.78rem;

    font-weight: 900;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .completion-screen > h2 {
    margin: 0.35rem 0 0.8rem;

    font-size: 2.6rem;
  }

  .completion-intro {
    font-size: 1.12rem;
  }

  .completion-score-card {
    display: inline-flex;

    gap: 1.3rem;

    align-items: center;

    margin: 1.6rem auto;

    padding: 1rem 1.4rem;

    border: 1px solid #d4e7e4;

    border-radius: 16px;

    background: #f6fbfa;

    text-align: left;
  }

  .score-label {
    display: block;

    margin-bottom: 0.2rem;

    color: #819092;

    font-size: 0.7rem;

    font-weight: 800;

    text-transform: uppercase;
  }

  .completion-score-card strong {
    color: #14766f;
  }

  .score-divider {
    width: 1px;
    height: 34px;

    background: #d2e3e1;
  }

  .completion-card {
    display: flex;

    gap: 1rem;

    max-width: 650px;

    margin: 1rem auto 2rem;

    padding: 1.5rem;

    border: 1px solid #d3e7e3;

    border-radius: 17px;

    background: #eff9f7;

    text-align: left;
  }

  .completion-card > span {
    font-size: 2rem;
  }

  .completion-card p {
    margin-top: 0.4rem !important;
  }


  /* =====================================================
     CERTIFICATE GENERATOR
  ====================================================== */

  .certificate-generator {
    max-width: 700px;

    margin: 2.5rem auto;

    padding: 1.6rem;

    border: 1px solid #e0d5bd;

    border-radius: 20px;

    background:
      linear-gradient(
        145deg,
        #fffdf8,
        #ffffff
      );

    text-align: left;

    box-shadow:
      0 8px 22px rgba(84, 67, 38, 0.05);
  }

  .certificate-generator-heading {
    display: flex;

    gap: 1rem;

    margin-bottom: 1.3rem;
  }

  .certificate-heading-icon {
    display: flex;

    width: 3rem;
    height: 3rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: #fff6dc;

    font-size: 1.6rem;
  }

  .certificate-generator h3 {
    margin: 0 0 0.3rem;

    color: #3d4c4d;
  }

  .certificate-generator-heading p {
    font-size: 0.92rem;
  }

  .certificate-form label {
    display: block;

    margin-bottom: 0.45rem;

    color: #485e61;

    font-size: 0.85rem;

    font-weight: 800;
  }

  .certificate-input-row {
    display: flex;

    gap: 0.75rem;
  }

  .certificate-input-row input {
    flex: 1;

    min-width: 0;

    padding: 0.9rem 1rem;

    border: 1px solid #ccdcd9;

    border-radius: 12px;

    outline: none;

    color: #314f53;

    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .certificate-input-row input:focus {
    border-color: #14766f;

    box-shadow:
      0 0 0 3px rgba(20, 118, 111, 0.1);
  }

  .certificate-error {
    margin-top: 0.5rem !important;

    color: #a64d4d !important;

    font-size: 0.85rem;
  }


  /* =====================================================
     CERTIFICATE AREA
  ====================================================== */

  .certificate-area {
    margin: 3rem auto;
  }

  .certificate {
    max-width: 850px;

    margin: 0 auto;

    padding: 14px;

    background:
      linear-gradient(
        135deg,
        #c39442,
        #e8d29d,
        #a8792d
      );

    box-shadow:
      0 20px 50px rgba(44, 54, 55, 0.14);
  }

  .certificate-border {
    position: relative;

    padding: 3rem 3.5rem 2.3rem;

    border: 2px solid #d6b86c;

    background:
      radial-gradient(
        circle at top left,
        rgba(211, 181, 110, 0.12),
        transparent 28%
      ),
      radial-gradient(
        circle at bottom right,
        rgba(20, 118, 111, 0.08),
        transparent 32%
      ),
      #fffefb;

    color: #374d50;

    text-align: center;
  }

  .certificate-top {
    display: flex;

    gap: 0.6rem;

    align-items: center;
    justify-content: center;

    margin-bottom: 2rem;
  }

  .certificate-logo-mark {
    display: flex;

    width: 2rem;
    height: 2rem;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #14766f;

    color: white;

    font-size: 0.8rem;
  }

  .certificate-brand {
    color: #53686b;

    font-size: 0.8rem;

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .certificate-decoration {
    display: flex;

    gap: 1rem;

    align-items: center;
    justify-content: center;

    margin-bottom: 1.7rem;
  }

  .certificate-decoration span {
    width: 70px;
    height: 1px;

    background: #caaa5e;
  }

  .certificate-decoration strong {
    color: #967129;

    font-family: Georgia, serif;

    font-size: 1.05rem;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .certificate-presents {
    margin-bottom: 0.7rem !important;

    color: #7c8a8b !important;

    font-size: 0.95rem;
  }

  .certificate-name {
    display: inline-block;

    min-width: 60%;

    margin: 0 auto 0.8rem;

    padding: 0.25rem 1rem 0.45rem;

    border-bottom: 1px solid #c3a75f;

    color: #183e40;

    font-family: Georgia, serif;

    font-size: clamp(
      2rem,
      5vw,
      3.4rem
    );

    font-weight: 700;

    line-height: 1.15;
  }

  .certificate-copy {
    margin: 0.7rem 0 !important;

    color: #758486 !important;

    font-size: 0.95rem;
  }

  .certificate h2 {
    margin: 1rem 0;

    color: #14766f;

    font-family: Georgia, serif;

    font-size: clamp(
      1.8rem,
      4vw,
      2.7rem
    );
  }

  .certificate-description {
    max-width: 650px;

    margin: 0 auto !important;

    color: #667b7d !important;

    font-size: 0.9rem;

    line-height: 1.65;
  }

  .certificate-footer {
    display: grid;

    grid-template-columns:
      1fr auto 1fr;

    gap: 1.5rem;

    align-items: end;

    margin-top: 2.5rem;
  }

  .certificate-footer-item {
    padding-top: 0.7rem;

    border-top: 1px solid #bfcac9;

    text-align: left;
  }

  .certificate-footer-item.right {
    text-align: right;
  }

  .certificate-footer-item span,
  .certificate-footer-item strong {
    display: block;
  }

  .certificate-footer-item span {
    margin-bottom: 0.2rem;

    color: #8c999a;

    font-size: 0.7rem;

    text-transform: uppercase;
  }

  .certificate-footer-item strong {
    color: #4c6062;

    font-size: 0.88rem;
  }

  .certificate-seal {
    text-align: center;
  }

  .seal-inner {
    display: flex;

    width: 3.3rem;
    height: 3.3rem;

    align-items: center;
    justify-content: center;

    margin: 0 auto 0.25rem;

    border: 3px double #b9913f;

    border-radius: 50%;

    color: #a37b2e;

    font-size: 1.3rem;

    font-weight: 900;
  }

  .certificate-seal span {
    color: #a37b2e;

    font-size: 0.63rem;

    font-weight: 900;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  .certificate-note {
    margin-top: 2rem !important;

    color: #a0a9aa !important;

    font-size: 0.66rem;

    letter-spacing: 0.03em;
  }

  .certificate-actions {
    display: flex;

    gap: 0.8rem;

    justify-content: center;

    margin-top: 1.4rem;
  }

  .certificate-help {
    margin-top: 0.8rem !important;

    color: #7f9092 !important;

    font-size: 0.82rem;
  }


  /* =====================================================
     COMPLETION ACTIONS
  ====================================================== */

  .completion-actions {
    display: flex;

    gap: 0.8rem;

    justify-content: center;

    flex-wrap: wrap;

    margin-top: 2.5rem;
  }


  /* =====================================================
     DISCLAIMER
  ====================================================== */

  .module-disclaimer {
    margin-top: 2rem;

    padding: 1.3rem;

    border-radius: 14px;

    background: #f3f6f6;
  }

