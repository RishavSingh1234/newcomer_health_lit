---
import ResourceLayout from '../../components/ResourceLayout.astro';
---

<ResourceLayout
  icon="🏥"
  eyebrow="Newcomer learning module"
  title="How Healthcare Works in B.C."
  introduction="Learn the essentials of getting health coverage, finding healthcare, choosing the right place for care, and navigating the B.C. healthcare system."
>
  <div class="learning-module" data-learning-module>

    <!-- =====================================================
         WELCOME SCREEN
    ====================================================== -->
    <div class="module-welcome" data-welcome>
      <div class="welcome-badge">
        <span>✦</span>
        Interactive learning module
      </div>

      <h2>Welcome</h2>

      <p class="welcome-intro">
        Moving to a new country can make even simple healthcare decisions feel
        confusing. This short module introduces the most important parts of the
        healthcare system in British Columbia.
      </p>

      <div class="module-details">
        <div class="detail">
          <div class="detail-icon-wrap">
            <span class="detail-icon">⏱️</span>
          </div>

          <div>
            <strong>10–15 minutes</strong>
            <span>Estimated time</span>
          </div>
        </div>

        <div class="detail">
          <div class="detail-icon-wrap">
            <span class="detail-icon">📚</span>
          </div>

          <div>
            <strong>7 lessons</strong>
            <span>Short and practical</span>
          </div>
        </div>

        <div class="detail">
          <div class="detail-icon-wrap">
            <span class="detail-icon">✅</span>
          </div>

          <div>
            <strong>Knowledge check</strong>
            <span>5 questions</span>
          </div>
        </div>
      </div>

      <div class="learning-objectives">
        <div class="objectives-heading">
          <span>🎯</span>
          <h3>By the end of this module, you should be able to:</h3>
        </div>

        <ul>
          <li>Explain what MSP is and what it covers.</li>
          <li>Know how to look for a family doctor or nurse practitioner.</li>
          <li>
            Choose between primary care, urgent care, 8-1-1 and emergency care.
          </li>
          <li>Understand how referrals, tests and prescriptions work.</li>
          <li>
            Identify common healthcare services that may not be fully covered.
          </li>
        </ul>
      </div>

      <div class="saved-progress" data-saved-progress hidden>
        <div class="saved-progress-icon">↻</div>

        <div>
          <strong>Welcome back!</strong>
          <p data-saved-progress-text></p>
        </div>
      </div>

      <div class="welcome-actions">
        <button class="primary-button large-button" type="button" data-start>
          <span>Start Module</span>
          <span class="button-arrow">→</span>
        </button>

        <button class="text-button" type="button" data-reset>
          Reset progress
        </button>
      </div>
    </div>


    <!-- =====================================================
         ACTIVE MODULE
    ====================================================== -->
    <div class="module-shell" data-module-shell hidden>

      <!-- PROGRESS CARD -->
      <div class="progress-header">
        <div class="progress-top">
          <div class="progress-title-area">
            <div class="progress-mini-icon">✓</div>

            <div>
              <span class="progress-small-label">Your progress</span>
              <strong data-progress-label>Lesson 1 of 7</strong>
            </div>
          </div>

          <div class="progress-percentage">
            <strong data-progress-percent>0%</strong>
            <span>complete</span>
          </div>
        </div>

        <div
          class="progress-track"
          role="progressbar"
          aria-label="Module progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-progress-track
        >
          <div class="progress-fill" data-progress-fill>
            <div class="progress-shine"></div>
          </div>
        </div>
      </div>


      <!-- =====================================================
           LESSON NAVIGATION
      ====================================================== -->
      <div class="lesson-navigation-wrapper">
        <div class="lesson-navigation" aria-label="Module lessons">

          <button type="button" class="lesson-tab" data-step="0">
            <span class="step-circle">1</span>

            <span class="step-text">
              <span class="step-label">Lesson 1</span>
              <span class="step-name">The B.C. system</span>
            </span>
          </button>

          <button type="button" class="lesson-tab" data-step="1">
            <span class="step-circle">2</span>

            <span class="step-text">
              <span class="step-label">Lesson 2</span>
              <span class="step-name">MSP coverage</span>
            </span>
          </button>

          <button type="button" class="lesson-tab" data-step="2">
            <span class="step-circle">3</span>

            <span class="step-text">
              <span class="step-label">Lesson 3</span>
              <span class="step-name">Primary care</span>
            </span>
          </button>

          <button type="button" class="lesson-tab" data-step="3">
            <span class="step-circle">4</span>

            <span class="step-text">
              <span class="step-label">Lesson 4</span>
              <span class="step-name">Where to go</span>
            </span>
          </button>

          <button type="button" class="lesson-tab" data-step="4">
            <span class="step-circle">5</span>

            <span class="step-text">
              <span class="step-label">Lesson 5</span>
              <span class="step-name">Specialists & tests</span>
            </span>
          </button>

          <button type="button" class="lesson-tab" data-step="5">
            <span class="step-circle">6</span>

            <span class="step-text">
              <span class="step-label">Lesson 6</span>
              <span class="step-name">Medications & costs</span>
            </span>
          </button>

          <button type="button" class="lesson-tab" data-step="6">
            <span class="step-circle">7</span>

            <span class="step-text">
              <span class="step-label">Lesson 7</span>
              <span class="step-name">Language support</span>
            </span>
          </button>

          <button
            type="button"
            class="lesson-tab quiz-tab"
            data-step="7"
          >
            <span class="step-circle">✓</span>

            <span class="step-text">
              <span class="step-label">Final step</span>
              <span class="step-name">Knowledge check</span>
            </span>
          </button>

        </div>
      </div>


      <!-- =====================================================
           LESSON 1
      ====================================================== -->
      <article class="lesson" data-lesson="0">
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 1</span>

          <h2>How healthcare works in B.C.</h2>

          <p>
            Start with the big picture: who pays for healthcare and where you
            usually enter the system.
          </p>
        </div>

        <div class="content-block">
          <h3>Publicly funded healthcare</h3>

          <p>
            British Columbia has a publicly funded healthcare system. If you
            are eligible and enrolled in the Medical Services Plan
            (<strong>MSP</strong>), many medically necessary healthcare
            services are paid for by the province.
          </p>
        </div>

        <div class="plain-language">
          <div class="plain-icon">💡</div>

          <div>
            <strong>In simple terms</strong>

            <p>
              You usually do not receive a bill when you see an MSP-covered
              physician for a medically necessary visit.
            </p>
          </div>
        </div>

        <div class="content-block">
          <h3>
            But “universal healthcare” does not mean everything is free
          </h3>

          <p>
            Prescription medications, routine dental care, eyeglasses,
            physiotherapy and other health services may be handled separately.
            We will cover these later in the module.
          </p>
        </div>

        <div class="lesson-takeaway">
          <div class="takeaway-icon">⭐</div>

          <div>
            <strong>Key takeaway</strong>

            <p>
              MSP is the foundation of B.C.'s public healthcare system, but it
              does not pay for every health-related service.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           LESSON 2
      ====================================================== -->
      <article class="lesson" data-lesson="1" hidden>
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 2</span>

          <h2>MSP and health coverage</h2>

          <p>
            Learn what MSP covers and an important rule for people who have
            recently moved to B.C.
          </p>
        </div>

        <div class="coverage-grid">
          <div class="coverage-card covered">
            <span class="card-icon success-icon">✓</span>

            <h3>Commonly covered</h3>

            <ul>
              <li>Medically necessary physician visits</li>
              <li>Medically required hospital care</li>
              <li>Many medically necessary diagnostic tests</li>
              <li>Medically required specialist care</li>
            </ul>
          </div>

          <div class="coverage-card not-covered">
            <span class="card-icon question-icon">?</span>

            <h3>May not be fully covered</h3>

            <ul>
              <li>Routine dental care</li>
              <li>Prescription medications</li>
              <li>Eyeglasses</li>
              <li>Many routine adult eye examinations</li>
              <li>Many physiotherapy or massage services</li>
            </ul>
          </div>
        </div>

        <div class="important-box">
          <div class="important-heading">
            <span>⏳</span>
            <strong>Important for newcomers</strong>
          </div>

          <p>
            New and returning residents may have an MSP waiting period.
            The usual waiting period is the
            <strong>
              remainder of the month in which residence is established in B.C.,
              plus two additional months.
            </strong>
          </p>

          <p>
            Apply for MSP as soon as possible after arriving rather than
            waiting for the waiting period to finish.
          </p>
        </div>

        <div class="example">
          <span class="example-label">Example</span>

          <p>
            If you establish residence in B.C. on May 10, the usual waiting
            period would include the rest of May, all of June and all of July.
            Coverage would generally begin August 1 if eligibility and
            enrolment requirements are met.
          </p>
        </div>

        <p class="fine-print">
          Individual eligibility can vary based on residency and immigration
          circumstances.
        </p>

        <div class="lesson-takeaway">
          <div class="takeaway-icon">⭐</div>

          <div>
            <strong>Key takeaway</strong>

            <p>
              Apply for MSP early. Do not assume healthcare coverage starts
              immediately when you arrive in B.C.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           LESSON 3
      ====================================================== -->
      <article class="lesson" data-lesson="2" hidden>
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 3</span>

          <h2>Your regular healthcare provider</h2>

          <p>
            Family doctors and nurse practitioners are usually the starting
            point for ongoing, non-emergency healthcare.
          </p>
        </div>

        <div class="provider-grid">
          <div class="provider-card">
            <span class="provider-icon">🩺</span>

            <h3>They can help with</h3>

            <ul>
              <li>New health concerns</li>
              <li>Routine follow-up</li>
              <li>Chronic medical conditions</li>
              <li>Preventive care</li>
              <li>Prescriptions</li>
            </ul>
          </div>

          <div class="provider-card">
            <span class="provider-icon">🧪</span>

            <h3>They can arrange</h3>

            <ul>
              <li>Blood tests</li>
              <li>Medical imaging</li>
              <li>Other investigations</li>
              <li>Specialist referrals</li>
              <li>Follow-up after treatment</li>
            </ul>
          </div>
        </div>

        <div class="content-block">
          <h3>What if I do not have a family doctor?</h3>

          <p>
            You can register with the provincial
            <strong>Health Connect Registry</strong> if you need a family
            doctor or nurse practitioner.
          </p>
        </div>

        <div class="steps">
          <div class="step">
            <span class="step-number">1</span>

            <div>
              <strong>Register</strong>

              <p>
                Join the Health Connect Registry if you need a regular primary
                care provider.
              </p>
            </div>
          </div>

          <div class="step">
            <span class="step-number">2</span>

            <div>
              <strong>Use available services while you wait</strong>

              <p>
                Walk-in clinics, UPCCs, pharmacies and 8-1-1 may still be
                available depending on your health concern.
              </p>
            </div>
          </div>

          <div class="step">
            <span class="step-number">3</span>

            <div>
              <strong>Get matched</strong>

              <p>
                Your local attachment team may contact you when a suitable
                provider becomes available.
              </p>
            </div>
          </div>
        </div>

        <div class="lesson-takeaway">
          <div class="takeaway-icon">⭐</div>

          <div>
            <strong>Key takeaway</strong>

            <p>
              A family doctor or nurse practitioner is ideal for ongoing care,
              but you still have healthcare options while waiting to find one.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           LESSON 4
      ====================================================== -->
      <article class="lesson" data-lesson="3" hidden>
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 4</span>

          <h2>Where should I go for care?</h2>

          <p>
            Different healthcare services are designed for different levels of
            urgency.
          </p>
        </div>

        <div class="care-options">
          <div class="care-card">
            <span class="care-icon">👨‍⚕️</span>

            <h3>Family doctor or NP</h3>

            <span class="best-for">Best for</span>

            <p>
              Routine care, ongoing problems, prevention, prescriptions and
              non-emergency concerns.
            </p>
          </div>

          <div class="care-card">
            <span class="care-icon">🚶</span>

            <h3>Walk-in clinic</h3>

            <span class="best-for">Best for</span>

            <p>
              Non-emergency problems when your regular provider is unavailable
              or you do not have one.
            </p>
          </div>

          <div class="care-card">
            <span class="care-icon">🏥</span>

            <h3>Urgent & Primary Care Centre</h3>

            <span class="best-for">Best for</span>

            <p>
              Urgent same-day problems that are not life-threatening.
            </p>
          </div>

          <div class="care-card">
            <span class="care-icon">☎️</span>

            <h3>HealthLink BC: 8-1-1</h3>

            <span class="best-for">Best for</span>

            <p>
              When you are unsure what care you need or need health information
              and navigation.
            </p>
          </div>

          <div class="care-card emergency-card">
            <span class="care-icon">🚑</span>

            <h3>9-1-1 / Emergency Department</h3>

            <span class="best-for">Best for</span>

            <p>
              Serious or potentially life-threatening emergencies.
            </p>
          </div>
        </div>


        <!-- INTERACTIVE SCENARIO -->
        <div class="scenario-box">
          <div class="scenario-header">
            <div class="scenario-icon">🧠</div>

            <div>
              <span class="activity-label">Try it yourself</span>

              <h3>Where would you go?</h3>
            </div>
          </div>

          <p>
            You develop a sore throat and fever. You are breathing normally,
            awake and otherwise stable. You do not have a family doctor.
          </p>

          <p class="scenario-question">
            Which is the most reasonable option below?
          </p>

          <div class="scenario-options">
            <button
              type="button"
              class="scenario-choice"
              data-scenario-choice="911"
            >
              <span>🚑</span>
              <span>Call 9-1-1</span>
            </button>

            <button
              type="button"
              class="scenario-choice"
              data-scenario-choice="primary"
            >
              <span>🏥</span>
              <span>Walk-in clinic / primary care</span>
            </button>

            <button
              type="button"
              class="scenario-choice"
              data-scenario-choice="ignore"
            >
              <span>🛋️</span>

              <span>
                Healthcare is not available without a family doctor
              </span>
            </button>
          </div>

          <div
            class="scenario-feedback"
            data-scenario-feedback
            hidden
          ></div>
        </div>

        <div class="notice">
          <strong>Unsure what level of care you need?</strong>

          <p>
            HealthLink BC at 8-1-1 can help you decide what healthcare service
            may be appropriate.
          </p>
        </div>

        <div class="lesson-takeaway">
          <div class="takeaway-icon">⭐</div>

          <div>
            <strong>Key takeaway</strong>

            <p>
              Use emergency services for emergencies. For most other problems,
              start with primary or urgent care — and call 8-1-1 if you are
              unsure.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           LESSON 5
      ====================================================== -->
      <article class="lesson" data-lesson="4" hidden>
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 5</span>

          <h2>Specialists and medical tests</h2>

          <p>
            Learn what usually happens when your healthcare problem needs
            additional investigation or expertise.
          </p>
        </div>

        <div class="journey">
          <div class="journey-item">
            <span>1</span>
            <strong>See a primary care provider</strong>
          </div>

          <div class="journey-arrow">→</div>

          <div class="journey-item">
            <span>2</span>
            <strong>Your problem is assessed</strong>
          </div>

          <div class="journey-arrow">→</div>

          <div class="journey-item">
            <span>3</span>
            <strong>Tests or referral may be ordered</strong>
          </div>

          <div class="journey-arrow">→</div>

          <div class="journey-item">
            <span>4</span>
            <strong>You are contacted for next steps</strong>
          </div>
        </div>

        <div class="content-block">
          <h3>Seeing a specialist</h3>

          <p>
            A specialist is a physician with additional training in an area
            such as cardiology, dermatology or surgery.
          </p>

          <p>
            Many specialist services are accessed through a referral from
            another healthcare provider. Waiting times can vary based on the
            specialty, location and urgency of your condition.
          </p>
        </div>

        <div class="content-block">
          <h3>Medical tests</h3>

          <p>
            Blood tests, X-rays, ultrasounds and other investigations may
            require an order from an appropriate healthcare provider.
          </p>

          <p>
            Being sent for a test does not necessarily mean that something
            serious is wrong. Tests are often used to help identify or rule out
            possible causes.
          </p>
        </div>

        <div class="lesson-takeaway">
          <div class="takeaway-icon">⭐</div>

          <div>
            <strong>Key takeaway</strong>

            <p>
              Primary care providers often act as the connection between you,
              medical tests and specialist care.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           LESSON 6
      ====================================================== -->
      <article class="lesson" data-lesson="5" hidden>
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 6</span>

          <h2>Medications and healthcare costs</h2>

          <p>
            Some healthcare services are funded differently from physician and
            hospital care.
          </p>
        </div>

        <div class="content-block">
          <h3>Prescription medications</h3>

          <p>
            Prescriptions are usually filled at community pharmacies.
            Pharmacists can explain how medications should be taken, answer
            medication questions and help identify potential problems.
          </p>
        </div>

        <div class="important-box medication-box">
          <div class="important-heading">
            <span>💊</span>

            <strong>
              MSP does not automatically pay for every prescription.
            </strong>
          </div>

          <p>
            B.C. PharmaCare helps eligible residents with the cost of many
            prescription drugs, pharmacy services and some medical supplies.
            Coverage depends on the medication and PharmaCare plan.
          </p>
        </div>

        <div class="not-free-grid">
          <div>
            <span>🦷</span>

            <h3>Dental care</h3>

            <p>
              Most routine dental services are not covered through MSP.
            </p>
          </div>

          <div>
            <span>👓</span>

            <h3>Vision</h3>

            <p>
              Eyeglasses and many routine adult eye examinations are not
              universally covered.
            </p>
          </div>

          <div>
            <span>🧘</span>

            <h3>Other services</h3>

            <p>
              Physiotherapy, massage therapy and counselling may require
              insurance or out-of-pocket payment in many situations.
            </p>
          </div>

          <div>
            <span>💼</span>

            <h3>Extended health insurance</h3>

            <p>
              Employers, schools or private plans may help cover services not
              included in MSP.
            </p>
          </div>
        </div>

        <div class="lesson-takeaway">
          <div class="takeaway-icon">⭐</div>

          <div>
            <strong>Key takeaway</strong>

            <p>
              Public healthcare does not mean every health expense is covered.
              Ask about PharmaCare, private insurance and lower-cost options
              when cost is a concern.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           LESSON 7
      ====================================================== -->
      <article class="lesson" data-lesson="6" hidden>
        <div class="lesson-heading">
          <span class="lesson-number">Lesson 7</span>

          <h2>Language and newcomer support</h2>

          <p>
            Language should not prevent you from asking questions or seeking
            healthcare.
          </p>
        </div>

        <div class="language-card">
          <div class="language-icon">🌎</div>

          <div>
            <h3>HealthLink BC offers interpretation</h3>

            <p>
              Call <strong>8-1-1</strong>. You will first reach an
              English-speaking navigator. Say the name of the language you need
              and an interpreter can be added to the call.
            </p>
          </div>
        </div>

        <div class="content-block">
          <h3>At clinics and hospitals</h3>

          <p>
            Healthcare organizations may also have interpretation services.
            Ask the clinic or healthcare team if you need an interpreter.
          </p>
        </div>

        <div class="content-block">
          <h3>Community organizations</h3>

          <p>
            Newcomer and settlement organizations may help you understand the
            healthcare system, complete applications, find community services
            and connect with other forms of support.
          </p>
        </div>

        <div class="five-things">
          <div class="five-things-title">
            <span>📌</span>
            <h3>The five things to remember</h3>
          </div>

          <div class="memory-row">
            <span>1</span>

            <p>
              <strong>Apply for MSP early.</strong>
            </p>
          </div>

          <div class="memory-row">
            <span>2</span>

            <p>
              <strong>Register for the Health Connect Registry</strong> if you
              need a regular family doctor or nurse practitioner.
            </p>
          </div>

          <div class="memory-row">
            <span>3</span>

            <p>
              <strong>Use primary care</strong> for most everyday,
              non-emergency health concerns.
            </p>
          </div>

          <div class="memory-row">
            <span>4</span>

            <p>
              <strong>Call 8-1-1 if you are unsure</strong> where to get care.
            </p>
          </div>

          <div class="memory-row">
            <span>5</span>

            <p>
              <strong>Call 9-1-1 for a life-threatening emergency.</strong>
            </p>
          </div>
        </div>

        <div class="lesson-takeaway final-takeaway">
          <div class="takeaway-icon">🎓</div>

          <div>
            <strong>You have reached the end of the lessons.</strong>

            <p>
              Next, complete the short knowledge check to finish the module.
            </p>
          </div>
        </div>
      </article>


      <!-- =====================================================
           KNOWLEDGE CHECK
      ====================================================== -->
      <article
        class="lesson quiz-lesson"
        data-lesson="7"
        hidden
      >
        <div class="lesson-heading">
          <span class="lesson-number quiz-number">
            Knowledge check
          </span>

          <h2>Check what you learned</h2>

          <p>
            Answer five questions. A score of <strong>4 out of 5</strong> is
            required to complete the module.
          </p>
        </div>

        <div class="quiz-intro-card">
          <div class="quiz-intro-icon">🧠</div>

          <div>
            <strong>Don't worry — this isn't an exam.</strong>

            <p>
              You can review your answers and try again if needed.
            </p>
          </div>
        </div>

        <form data-quiz>

          <!-- QUESTION 1 -->
          <fieldset
            class="quiz-question"
            data-question
            data-correct="b"
          >
            <legend>
              <span>1</span>

              For most routine, non-emergency health concerns, which provider
